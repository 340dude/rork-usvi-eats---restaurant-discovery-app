{
  "expo": {
    "name": "VI Eats - Restaurant Discovery App",
    "slug": "vi-eats-restaurant-discovery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00647A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vieats.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VI Eats uses your location to show how far restaurants are and sort results by distance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00647A"
      },
      "package": "com.vieats.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VI Eats uses your location to show how far restaurants are and sort results by distance."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
