# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> Data API in the Supabase dashboard).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run scripts/seed.ts (Project Settings -> API -> service_role key).
# Never commit this or ship it in the app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
